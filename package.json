{
  "name": "storage-manager-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build:lib": "ng build storage-manager",
    "build:showcase": "ng build showcase",
    "test": "ng test storage-manager --watch=false",
    "test:coverage": "ng test storage-manager --watch=false --coverage",
    "start:showcase": "npm run build:lib && ng serve showcase",
    "docs": "compodoc -p projects/storage-manager/tsconfig.doc.json -d documentation --name \"ngx-uceva-storage-manager\" --disablePrivate --disableProtected --disableInternal --disableDependencies",
    "docs:serve": "compodoc -p projects/storage-manager/tsconfig.doc.json -d documentation --name \"ngx-uceva-storage-manager\" --disablePrivate --disableProtected --disableInternal --disableDependencies -s",
    "docs:coverage": "compodoc -p projects/storage-manager/tsconfig.doc.json -d documentation --name \"ngx-uceva-storage-manager\" --disablePrivate --disableProtected --disableInternal --disableDependencies --coverageTest 100 --silent",
    "build:lib:prod": "ng build storage-manager --configuration production",
    "pack:lib": "npm pack ./dist/storage-manager --dry-run",
    "release:check": "npm run test:coverage && npm run docs:coverage && npm run build:lib:prod && npm run pack:lib"
  },
  "private": true,
  "packageManager": "npm@12.2.1",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@compodoc/compodoc": "^2.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
